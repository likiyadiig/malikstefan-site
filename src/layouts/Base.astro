---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/building', label: 'What I am Building' },
	{ href: '/log', label: 'Log' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header>
			<nav aria-label="Primary">
				<ul>
					{
						nav.map(({ href, label }) => (
							<li>
								<a href={href} aria-current={path === href ? 'page' : undefined}>
									{label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer>
			<p>
				<!-- TODO: footer line. Name, tagline, or nothing at all. -->
				Malik Stefan &middot; {year}
			</p>
			<p>
				<!-- TODO: contact address, or delete this paragraph. -->
				<a href="mailto:TODO@malikstefan.com">TODO@malikstefan.com</a>
			</p>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--ink: #16150f;
		--ink-soft: #55524a;
		--paper: #fbfaf7;
		--rule: #ddd9d0;
		--link: #1a4f8a;
		--measure: 680px;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		/* 18px root: every rem below is anchored to the 18px minimum. */
		font-size: 18px;
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		padding: 0 1.25rem;
		background: var(--paper);
		color: var(--ink);
		font-family: ui-serif, Georgia, 'Times New Roman', serif;
		font-size: 1rem;
		line-height: 1.6;
	}

	h1,
	h2,
	h3 {
		line-height: 1.2;
		font-weight: 600;
		text-wrap: balance;
	}

	h1 {
		font-size: 2rem;
		margin: 0 0 0.5rem;
	}

	h2 {
		font-size: 1.375rem;
		margin: 2.5rem 0 0.5rem;
	}

	h3 {
		font-size: 1.125rem;
		margin: 1.75rem 0 0.25rem;
	}

	p,
	li {
		font-size: 1rem;
	}

	a {
		color: var(--link);
	}

	ul,
	ol {
		padding-left: 1.25rem;
	}

	:focus-visible {
		outline: 2px solid var(--link);
		outline-offset: 2px;
	}
</style>

<style>
	.skip {
		position: absolute;
		left: -9999px;
	}

	.skip:focus {
		position: static;
		display: inline-block;
		padding: 0.5rem 0;
	}

	header,
	main,
	footer {
		max-width: var(--measure);
		margin: 0 auto;
	}

	header {
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--rule);
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		text-decoration: none;
	}

	nav a:hover,
	nav a:focus-visible {
		text-decoration: underline;
	}

	nav a[aria-current='page'] {
		color: var(--ink);
		font-weight: 600;
	}

	main {
		padding: 2.5rem 0 3.5rem;
	}

	footer {
		padding: 1.5rem 0 3rem;
		border-top: 1px solid var(--rule);
		color: var(--ink-soft);
	}

	footer p {
		margin: 0.25rem 0;
		font-size: 1rem;
	}
</style>
