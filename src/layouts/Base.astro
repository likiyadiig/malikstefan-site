---
interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;

const nav = [
	{ href: '/', label: 'Home' },
	{ href: '/about', label: 'About' },
	{ href: '/building', label: 'What I am Building' },
	{ href: '/log', label: 'Log' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const year = new Date().getFullYear();
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0e0e0c" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>

		<header>
			<nav aria-label="Primary">
				<ul>
					{
						nav.map(({ href, label }) => (
							<li>
								<a href={href} aria-current={path === href ? 'page' : undefined}>
									{label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer>
			<p>
				<!-- TODO: footer line. Name, tagline, or nothing at all. -->
				Malik Stefan &middot; {year}
			</p>
			<ul class="contact">
				<li>
					<a href="mailto:kontakt@malikstefan.com" aria-label="Email kontakt@malikstefan.com">
						<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
							<path
								fill="currentColor"
								d="M1.75 2h12.5c.966 0 1.75.784 1.75 1.75v8.5A1.75 1.75 0 0 1 14.25 14H1.75A1.75 1.75 0 0 1 0 12.25v-8.5C0 2.784.784 2 1.75 2ZM1.5 12.251c0 .138.112.25.25.25h12.5a.25.25 0 0 0 .25-.25V5.809L8.38 9.397a.75.75 0 0 1-.76 0L1.5 5.809v6.442Zm13-8.181v-.32a.25.25 0 0 0-.25-.25H1.75a.25.25 0 0 0-.25.25v.32L8 7.88Z"
							></path>
						</svg>
						kontakt@malikstefan.com
					</a>
				</li>
				<li>
					<a
						href="https://github.com/likiyadiig"
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub (opens in a new tab)"
					>
						<svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
							<path
								fill="currentColor"
								d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"
							></path>
						</svg>
						GitHub
					</a>
				</li>
			</ul>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		/* Contrast on --bg: ink 17:1, ink-soft 9:1, accent 12:1. --rule is decorative only. */
		--bg: #0e0e0c;
		--surface: #181815;
		--ink: #f3f1eb;
		--ink-soft: #b5b1a6;
		--rule: #34332e;
		--accent: #ffc53d;
		--measure: 680px;
		--serif: ui-serif, Georgia, 'Times New Roman', serif;
		--sans: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
		--mono: ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace;
		color-scheme: dark;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		/* 18px floor that still grows with a larger browser default. Every rem below inherits it. */
		font-size: max(18px, 112.5%);
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		padding: 0 1.25rem;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--serif);
		font-size: 1rem;
		line-height: 1.65;
		/* Long URLs and addresses wrap instead of pushing the page sideways. */
		overflow-wrap: break-word;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3 {
		color: var(--ink);
		line-height: 1.2;
		font-weight: 600;
		text-wrap: balance;
	}

	h1 {
		font-size: clamp(1.75rem, 1.25rem + 2.5vw, 2.25rem);
		letter-spacing: -0.01em;
		margin: 0 0 0.75rem;
	}

	h2 {
		font-size: 1.375rem;
		margin: 2.75rem 0 0.5rem;
	}

	h3 {
		font-size: 1.125rem;
		margin: 1.75rem 0 0.25rem;
	}

	/* Phones: body pinned to exactly 18px, lighter heading scale. */
	@media (max-width: 640px) {
		html {
			font-size: 18px;
		}

		h1 {
			font-size: 1.5rem;
		}

		h2 {
			font-size: 1.1875rem;
		}

		h3 {
			font-size: 1.0625rem;
		}
	}

	p,
	li {
		font-size: 1rem;
	}

	a {
		color: var(--accent);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.18em;
	}

	a:hover {
		text-decoration-thickness: 2px;
	}

	ul,
	ol {
		padding-left: 1.25rem;
	}

	li::marker {
		color: var(--ink-soft);
	}

	code,
	pre {
		font-family: var(--mono);
		font-size: 1rem;
	}

	code {
		padding: 0.05em 0.3em;
		border-radius: 3px;
		background: var(--surface);
	}

	pre {
		overflow-x: auto;
		padding: 1rem;
		border: 1px solid var(--rule);
		border-radius: 4px;
		background: var(--surface);
		line-height: 1.5;
	}

	pre code {
		padding: 0;
		background: none;
	}

	/* Markdown elements log entries may use. */
	blockquote {
		margin: 1.5rem 0;
		padding-left: 1rem;
		border-left: 3px solid var(--accent);
		color: var(--ink-soft);
	}

	hr {
		margin: 2.5rem 0;
		border: 0;
		border-top: 1px solid var(--rule);
	}

	table {
		/* Wide tables scroll inside themselves, never the page. */
		display: block;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
	}

	th,
	td {
		padding: 0.4rem 0.75rem 0.4rem 0;
		border-bottom: 1px solid var(--rule);
		text-align: left;
		vertical-align: top;
	}

	img,
	video {
		max-width: 100%;
		height: auto;
	}

	::selection {
		background: var(--accent);
		color: var(--bg);
	}

	:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 2px;
	}
</style>

<style>
	.skip {
		position: absolute;
		left: -9999px;
	}

	.skip:focus {
		left: 1.25rem;
		top: 0.75rem;
		z-index: 1;
		padding: 0.5rem 0.75rem;
		background: var(--accent);
		color: var(--bg);
		font-family: var(--sans);
	}

	header,
	main,
	footer {
		max-width: var(--measure);
		margin: 0 auto;
	}

	header {
		padding: 1rem 0;
		border-bottom: 1px solid var(--rule);
	}

	nav ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	nav a {
		/* Vertical padding brings each link to a 44px tap target. */
		display: inline-block;
		padding: 0.4rem 0;
		color: var(--ink-soft);
		font-family: var(--sans);
		text-decoration: none;
	}

	nav a:hover {
		color: var(--ink);
	}

	nav a[aria-current='page'] {
		color: var(--ink);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}

	main {
		padding: 2.5rem 0 4rem;
	}

	/* Name and year on the left, contact links on the right. Wraps to two lines when narrow. */
	footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.25rem 1.5rem;
		padding: 1.5rem 0 3rem;
		border-top: 1px solid var(--rule);
		color: var(--ink-soft);
		font-family: var(--sans);
	}

	footer p {
		margin: 0;
		font-size: 1rem;
	}

	/* Email and GitHub always share one row. */
	.contact {
		display: flex;
		flex-wrap: nowrap;
		gap: 0 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* On very narrow screens the address wraps inside its link instead of scrolling the page. */
	.contact li {
		min-width: 0;
	}

	.contact a {
		/* Same 44px tap target as the nav links. */
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		padding: 0.4rem 0;
	}

	.contact svg {
		width: 1em;
		height: 1em;
		flex-shrink: 0;
	}
</style>
