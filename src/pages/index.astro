---
import Nowhere from '../layouts/Nowhere.astro';

const START_DATE = new Date('2026-09-08T00:00:00Z');

const MS_PER_WEEK = 1000 * 60 * 60 * 24 * 7;
const week = Math.max(1, Math.floor((Date.now() - START_DATE.getTime()) / MS_PER_WEEK) + 1);

const startedLabel = START_DATE.toLocaleDateString('en-US', {
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	timeZone: 'UTC',
});
---

<Base
	title="Malik Machaieie"
	description="Learning to build and ship AI software in 20 weeks, in public. Weekly notes on what worked and what didn't."
>
	<h1>Malik Machaieie</h1>

	<p class="lede">
		Learning how to build and ship AI software.
	</p>

	<section aria-labelledby="week-heading">
		<h2 id="week-heading">Where I am</h2>
		<p>
			Week <strong>{week}</strong>, counting from <time datetime={START_DATE.toISOString().slice(0, 10)}>{startedLabel}</time>.
		</p>
		<p>
			Twenty weeks total. The goal is a paying customer by the end.
		</p>
	</section>

	<section aria-labelledby="elsewhere-heading">
		<h2 id="elsewhere-heading">Elsewhere on this site</h2>
		<ul>
			<li><a href="/about">About</a> — Who am I?</li>
			<li><a href="/building">What I am Building</a> — What I've built, and future ideas.</li>
			<li><a href="/log">Log</a> — Track my progress!</li>
		</ul>
	</section>

</Base>

<style>
	.lede {
		font-size: 1.25rem;
		line-height: 1.45;
		margin: 0 0 2rem;
	}

	#week-heading + p strong {
		color: var(--accent);
		font-variant-numeric: tabular-nums;
	}

</style>
