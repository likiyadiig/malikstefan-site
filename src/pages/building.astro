---
import Base from '../layouts/Base.astro';


const ideas = [
	{
		name: 'Services',
		leaning: true,
		what: 'Making websites for small businesses.',
		test: 'a lot of businesses currently falling behind due to bad websites, with a lot of them not even having one.',
	},
	{
		name: 'Automated content',
		leaning: false,
		what: 'Automated social media content creation agent',
		test: 'Although I still like this idea, it feels like a side hustle rather than a secure business model.',
	},
	{
		name: 'Products',
		leaning: false,
		what: 'Selling apps and tools',
		test: "The market for this seems very good, and I'd gladly get into it. But a product needs an audience to sell to, and I don't have one yet. Services get me paid from the first customer instead.",
	},
];
---

<Base
	title="What I am building"
	description="My ideas, what I'm leaning towards and why I didn't choose a different direction"
>
	<h1>What I am Building</h1>

	<p class="lede">
		I looked at Services, Content and Products. I'm going with Services, because it's a good market for someone starting their own business, and lets me actively seek out customers.
	</p>

	<section aria-labelledby="ideas-heading">
		<h2 id="ideas-heading">Current ideas</h2>

		{
			ideas.map((idea) => (
				<article class="idea">
					<h3>
						{idea.name}
						{idea.leaning && <span class="tag">leaning</span>}
					</h3>
					<p>
						{idea.what}
					</p>
					<p>
						{idea.test}
					</p>
				</article>
			))
		}
	</section>

</Base>

<style>
	.lede {
		font-size: 1.25rem;
		line-height: 1.45;
		margin: 0 0 2rem;
	}

	.idea {
		padding: 1.5rem 0;
		border-bottom: 1px solid var(--rule);
	}

	.idea h3 {
		margin-top: 0;
	}

	.idea p:last-child {
		margin-bottom: 0;
	}

	.tag {
		display: inline-block;
		margin-left: 0.5rem;
		padding: 0 0.55rem;
		border: 1px solid var(--accent);
		border-radius: 999px;
		color: var(--accent);
		font-family: var(--sans);
		/* 18px floor applies here too. */
		font-size: 1rem;
		font-weight: 500;
		line-height: 1.5;
		vertical-align: middle;
		white-space: nowrap;
	}
</style>
